# Copy to .env (never commit .env)
# Neo4j password, min 8 chars
NEO4J_PASSWORD=change-me-please
# Google AI Studio key used by litellm (Gemini)
GEMINI_API_KEY=

# Optional model overrides (litellm model strings)
# CS_EXTRACT_MODEL=gemini/gemini-3.5-flash
# CS_JUDGE_MODEL=gemini/gemini-3.5-flash   # use a Pro-class model (e.g. gemini/gemini-3.1-pro-preview) on a paid key
# CS_VISION_MODEL=gemini/gemini-3.5-flash
# CS_EMBED_MODEL=gemini/gemini-embedding-001
# CS_EMBED_DIM=768
# CS_LLM_CONCURRENCY=8
# CS_DISABLE_LLM=1                       # deterministic-only run (ablation / offline)

# Optional: match container user to your host user for the ./context_service/out bind mount
# HOST_UID=1000
# HOST_GID=1000
